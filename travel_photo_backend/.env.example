# Backend configuration for Travel Photo Backend

# Frontend origin for CORS (comma-separated not supported; single origin or *). In production, set your deployed frontend URL.
FRONTEND_ORIGIN=*

# Unsplash API access key (required for /unsplash/search)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Token TTL in minutes for demo bearer tokens
TOKEN_TTL_MINUTES=120
